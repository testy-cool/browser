# Lightpanda Server Configuration
# Copy this file to .env and customize for your deployment

# Server Port (default: 9222)
LIGHTPANDA_PORT=9222

# Timezone (default: UTC)
TZ=UTC

# HTTP Proxy Configuration
# Uncomment and configure if you need to route traffic through a proxy
# HTTP_PROXY=http://proxy.example.com:8080
# PROXY_BEARER_TOKEN=your_token_here

# User Agent Configuration
# Append custom string to the default "Lightpanda/1.0" user agent
# Example: "Chrome/124.0.0.0 Safari/537.36"
# USER_AGENT_SUFFIX=Chrome/124.0.0.0 Safari/537.36

# TLS/SSL Configuration
# Set to false to disable SSL verification (not recommended for production)
# TLS_VERIFY_HOST=true

# HTTP Client Configuration
# HTTP request timeout in seconds (default: 30)
# HTTP_TIMEOUT=30

# Maximum concurrent HTTP requests (default: 100)
# HTTP_MAX_CONCURRENT=100

# HTTP connect timeout in seconds (default: 10)
# HTTP_CONNECT_TIMEOUT=10

# Maximum open connections per host (default: 6)
# HTTP_MAX_HOST_OPEN=6

# Logging Configuration
# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Log format: text, json (default: text)
# LOG_FORMAT=text

# Examples for different use cases:

# --- Anti-Bot / Stealth Mode ---
# USER_AGENT_SUFFIX=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# LOG_LEVEL=warn

# --- With Rotating Proxy Service ---
# HTTP_PROXY=http://proxy-provider.com:8080
# PROXY_BEARER_TOKEN=your_api_key_here
# TLS_VERIFY_HOST=true

# --- Development/Testing ---
# LOG_LEVEL=debug
# TLS_VERIFY_HOST=false
# HTTP_TIMEOUT=60
